<Window x:Class="XboxManager.Glissement"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Mesure du glissement" Height="600" Width="900"
        WindowStyle="None" AllowsTransparency="False"
        Background="#202020">
  <!-- `UseAeroCaptionButtons` n'existe PAS sur `Window` : c'est une propriete de
       `WindowChrome` (voir MainWindow). Ici, sans WindowChrome, la fenetre n'a
       simplement aucun bouton de legende. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="48"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <!-- Bande A : le glissement vient de la PAGE (-webkit-app-region: drag) -->
    <Border x:Name="BandeA" Grid.Row="0" Background="#2d2d2d">
      <TextBlock Text="A — app-region (glisser ici)" Foreground="White"
                 VerticalAlignment="Center" Margin="12,0"/>
    </Border>
    <!-- Bande B : le glissement vient du C# (MouseLeftButtonDown -> DragMove) -->
    <Border x:Name="BandeB" Grid.Row="1" Background="#3a3a3a"
            MouseLeftButtonDown="BandeB_Souris">
      <TextBlock Text="B — DragMove() (glisser ici)" Foreground="White"
                 VerticalAlignment="Center" Margin="12,0"/>
    </Border>
    <wv2:WebView2 x:Name="Vue" Grid.Row="2"/>
    <!-- Le repli SE DIT, dans la fenetre : une boite de dialogue bloquerait un
         lancement automatique (fermeture differee, demarrage sans surveillance).
         PIEGE XAML, deja mordu deux fois ici : un commentaire XML ne peut pas
         contenir deux tirets qui se suivent — les noms d'arguments s'ecrivent
         donc sans leur prefixe. -->
    <Border x:Name="Bandeau" Grid.Row="2" Visibility="Collapsed"
            Background="#DD000000" Padding="12">
      <TextBlock x:Name="TexteBandeau" Foreground="#FFF0F0F0" TextWrapping="Wrap" FontSize="13"/>
    </Border>
  </Grid>
</Window>
