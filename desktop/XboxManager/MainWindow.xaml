<Window x:Class="XboxManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Xbox 360 Manager" Height="900" Width="1440" MinHeight="600" MinWidth="900"
        WindowStyle="None" Background="#202020">
  <WindowChrome.WindowChrome>
    <!-- La page occupe TOUT : c'est l'en-tete de l'application qui sert de barre
         de titre (spec §2, decision A). CaptionHeight vaut 0 parce que le
         deplacement est gere autrement (voir la mesure du glissement) ; le
         ResizeBorderThickness laisse les bords redimensionnables.
         PIEGE XAML : un commentaire XML ne supporte pas deux tirets qui se
         suivent — les noms d'arguments s'ecrivent ici sans leur prefixe. -->
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
  </WindowChrome.WindowChrome>
  <Grid>
    <wv2:WebView2 x:Name="Vue"/>
    <!-- TOUT CE QUI VA MAL SE DIT ICI, dans la fenetre : un Mica absent, un port
         occupe, un Node introuvable, un WebView2 qui ne demarre pas. Une boite de
         dialogue bloquerait un lancement automatique, et un message invisible
         laisserait l'utilisateur devant une fenetre vide. -->
    <Border x:Name="Bandeau" Visibility="Collapsed"
            Background="#E6000000" Padding="18">
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="TexteBandeau" Foreground="#FFF0F0F0" TextWrapping="Wrap"
                   FontSize="14" MaxWidth="820" HorizontalAlignment="Left"/>
        <TextBlock x:Name="TexteJournal" Foreground="#FFB9B9B9" TextWrapping="Wrap"
                   FontSize="12" Margin="0,10,0,0" MaxWidth="820" HorizontalAlignment="Left"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
